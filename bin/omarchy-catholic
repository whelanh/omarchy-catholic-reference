#!/usr/bin/env node
"use strict"

// omarchy-catholic — search backend for the Catholic Reference plugin.
//
// Reads the bundled Douay-Rheims index (data/bible.tsv), the canonical book
// table (data/books.json), and the Catechism (data/catechism.json), and emits
// tab-separated results the QML panel can parse:
//
//   STATUS\t<message>        a status/error line
//   RESULT\t<ref>\t<text>    one search hit
//
// Commands:
//   search bible QUERY       fuzzy text search + reference lookup
//   search catechism QUERY   fuzzy search over CCC paragraphs
//   read BOOK CH:V           exact reference lookup
//
// Fuzzy matching is subsequence-based, so "god so loved" finds
// "For God so loved the world…" without an exact quote.

const fs = require("fs")
const os = require("os")
const https = require("https")
const path = require("path")

const SCRIPT_ROOT = path.resolve(__dirname, "..")
const DATA_ROOT = path.join(SCRIPT_ROOT, "data")
const MAX_RESULTS = 40

// Ignore a closed pipe (e.g. output piped to `head`); the reader decides how
// much it wants.
process.stdout.on("error", function (err) {
  if (err && err.code === "EPIPE") process.exit(0)
  throw err
})

function readJson(file) {
  return JSON.parse(fs.readFileSync(file, "utf8"))
}

function status(msg) {
  process.stdout.write("STATUS\t" + msg + "\n")
}

function result(ref, text) {
  // Collapse newlines/tabs so each hit stays a single line the QML panel can
  // split on "\t" and "\n" unambiguously.
  const clean = String(text || "").replace(/\s+/g, " ").trim()
  process.stdout.write("RESULT\t" + ref + "\t" + clean + "\n")
}

function loadBooks() {
  return readJson(path.join(DATA_ROOT, "books.json"))
}

function loadBible() {
  const raw = fs.readFileSync(path.join(DATA_ROOT, "bible.tsv"), "utf8")
  const lines = raw.split("\n")
  const verses = []
  for (const line of lines) {
    const idx = line.indexOf("\t")
    if (idx < 0) continue
    const book = line.slice(0, idx)
    const rest = line.slice(idx + 1)
    const idx2 = rest.indexOf("\t")
    if (idx2 < 0) continue
    const ref = rest.slice(0, idx2)
    const text = rest.slice(idx2 + 1)
    verses.push({ book, ref, text })
  }
  return verses
}

function loadCatechism() {
  return readJson(path.join(DATA_ROOT, "catechism.json"))
}

// --- fuzzy matching -------------------------------------------------------

function subseqScore(query, text) {
  let score = 0
  let streak = 0
  let lastIdx = -1
  let ti = 0
  for (let qi = 0; qi < query.length; qi++) {
    const ch = query[qi]
    const idx = text.indexOf(ch, ti)
    if (idx === -1) return 0
    if (idx === lastIdx + 1) streak++
    else streak = 0
    let bonus = 1
    if (idx === 0) bonus += 16
    else {
      const prev = text[idx - 1]
      if (prev === " " || prev === "-" || prev === "," || prev === "." || prev === ";" || prev === ":" || prev === "(" || prev === "'")
        bonus += 10
    }
    score += bonus + Math.min(streak, 5)
    ti = idx + 1
    lastIdx = idx
  }
  return score
}

function escapeRegex(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
}

// Score a query against a text. A single-word query must match as a whole
// word (case-insensitive) so "cremation" never matches "created"/"creation".
// Multi-word phrases keep fuzzy subsequence matching, boosted heavily when
// every word also appears as a whole word.
function scoreMatch(query, text) {
  const q = String(query).toLowerCase().trim()
  if (!q) return 0
  const t = text.toLowerCase()
  const words = q.split(/\s+/).filter(Boolean)

  if (words.length === 1) {
    const re = new RegExp("\\b" + escapeRegex(words[0]) + "\\b", "g")
    const matches = t.match(re)
    if (!matches) return 0
    return 1000 + Math.min(matches.length, 20)
  }

  const compact = words.join("")
  let score = subseqScore(compact, t)
  if (score === 0) return 0
  let all = true
  for (const w of words) {
    if (!new RegExp("\\b" + escapeRegex(w) + "\\b").test(t)) { all = false; break }
  }
  if (all) score += 800
  if (t.indexOf(q) !== -1) score += 400
  return score
}

// --- book reference parsing -----------------------------------------------

function normalizeName(value) {
  return String(value || "").toLowerCase().replace(/[.\-,]/g, " ").replace(/\s+/g, " ").trim()
}

function bookForToken(books, token) {
  const needle = normalizeName(token)
  if (!needle) return null
  for (const b of books) {
    if (normalizeName(b.name) === needle) return b
    if (normalizeName(b.abbrev) === needle) return b
    for (const a of b.aliases || []) {
      if (normalizeName(a) === needle) return b
    }
  }
  return null
}

function parseReference(query, books) {
  const m = query.trim().match(/^(.+?)\s+(\d+)(?::(\d+))?$/)
  if (!m) return null
  const book = bookForToken(books, m[1])
  if (!book) return null
  return { book: book.name, chapter: parseInt(m[2], 10), verse: m[3] ? parseInt(m[3], 10) : null }
}

// --- commands -------------------------------------------------------------

function searchBible(query) {
  const books = loadBooks()
  const q = query.trim()
  if (!q) {
    status("Type a phrase, word, or reference to search the Bible.")
    return
  }
  const verses = loadBible()

  // Reference lookup: "John 3:16" or "Genesis 1".
  const ref = parseReference(q, books)
  if (ref) {
    const prefix = ref.verse ? `${ref.book}\t${ref.chapter}:${ref.verse}` : `${ref.book}\t${ref.chapter}:`
    const hits = []
    for (const v of verses) {
      const key = `${v.book}\t${v.ref}`
      if (ref.verse ? key === prefix : key.startsWith(prefix)) hits.push(v)
    }
    if (hits.length > 0) {
      for (const v of hits.slice(0, MAX_RESULTS)) result(`${v.book} ${v.ref}`, v.text)
      status(hits.length + " verse" + (hits.length === 1 ? "" : "s"))
      return
    }
    status("No verses match: " + q)
    return
  }

  // Fuzzy text search.
  const scored = []
  for (let i = 0; i < verses.length; i++) {
    const v = verses[i]
    const score = scoreMatch(q, v.text)
    if (score > 0) scored.push({ score, index: i, v })
  }
  scored.sort((a, b) => (b.score - a.score) || (a.index - b.index))
  const top = scored.slice(0, MAX_RESULTS)
  if (top.length === 0) {
    status("No matches for: " + q)
    return
  }
  for (const s of top) result(`${s.v.book} ${s.v.ref}`, s.v.text)
  status(top.length + " result" + (top.length === 1 ? "" : "s") + " · click to copy")
}

function searchCatechism(query) {
  const q = query.trim()
  if (!q) {
    status("Type a word or phrase to search the Catechism.")
    return
  }
  const paragraphs = loadCatechism()
  const scored = []
  for (let i = 0; i < paragraphs.length; i++) {
    const p = paragraphs[i]
    const score = scoreMatch(q, p.text)
    if (score > 0) scored.push({ score, index: i, p })
  }
  scored.sort((a, b) => (b.score - a.score) || (a.index - b.index))
  const top = scored.slice(0, MAX_RESULTS)
  if (top.length === 0) {
    status("No Catechism paragraphs match: " + q)
    return
  }
  for (const s of top) result("CCC " + s.p.id, s.p.text)
  status(top.length + " paragraph" + (top.length === 1 ? "" : "s") + " · click to copy")
}

function readReference(reference) {
  const books = loadBooks()
  const ref = parseReference(reference, books)
  if (!ref) {
    status("Unrecognized reference. Try \"John 3:16\".")
    return
  }
  const verses = loadBible()
  const prefix = ref.verse ? `${ref.book}\t${ref.chapter}:${ref.verse}` : `${ref.book}\t${ref.chapter}:`
  let found = 0
  for (const v of verses) {
    const key = `${v.book}\t${v.ref}`
    if (ref.verse ? key === prefix : key.startsWith(prefix)) {
      result(`${v.book} ${v.ref}`, v.text)
      found++
    }
  }
  if (found === 0) status("Reference not found: " + reference)
}

function randomVerse() {
  const verses = loadBible()
  if (verses.length === 0) { status("No Bible data available."); return }
  const v = verses[Math.floor(Math.random() * verses.length)]
  result(`${v.book} ${v.ref}`, v.text)
}

function randomCatechism() {
  const paragraphs = loadCatechism()
  if (paragraphs.length === 0) { status("No Catechism data available."); return }
  const p = paragraphs[Math.floor(Math.random() * paragraphs.length)]
  result("CCC " + p.id, p.text)
}

function usage() {
  process.stdout.write(
    [
      "Usage:",
      "  omarchy-catholic search bible QUERY",
      "  omarchy-catholic search catechism QUERY",
      "  omarchy-catholic read BOOK CH:V",
      "  omarchy-catholic random bible|catechism",
      "  omarchy-catholic readings [YYYY-MM-DD] [--refresh]",
      "",
      "Fuzzy search runs locally over the bundled Douay-Rheims Bible and the",
      "Catechism of the Catholic Church. `readings` fetches today's Mass",
      "readings from universalis.com and caches them locally.",
    ].join("\n") + "\n"
  )
}

// --- daily Mass readings (universalis.com) --------------------------------

const READINGS_UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
const MAX_RESPONSE_BYTES = 256 * 1024
const MAX_CACHE_BYTES = 256 * 1024
const READINGS_TIMEOUT_MS = 20000
const MAX_REDIRECTS = 5
const MAX_TABLES = 24
const MAX_READINGS = 10
const MAX_LINES_PER_READING = 600
const FIELD_CAPS = {
  title: 240,
  rubric: 160,
  color: 64,
  year: 64,
  label: 120,
  reference: 240,
  heading: 600,
  text: 24000
}

function cap(value, max) {
  const s = String(value || "")
  return s.length > max ? s.slice(0, max) : s
}

function decodeHtml(s) {
  return String(s)
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<[^>]+>/g, "")
    .replace(/&#x([0-9a-f]+);/gi, function (m, hex) {
      var cp = parseInt(hex, 16)
      try { return String.fromCodePoint(cp) } catch (e) { return "\uFFFD" }
    })
    .replace(/&#(\d+);/g, function (m, dec) {
      var cp = parseInt(dec, 10)
      try { return String.fromCodePoint(cp) } catch (e) { return "\uFFFD" }
    })
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/\u00a0/g, " ")
}

function match1(source, re) {
  const m = String(source).match(re)
  return m ? m[1] : ""
}

// Stream the HTTPS body with a strict byte ceiling, a timeout, and bounded
// redirect following.
function httpsGet(url, maxBytes, timeoutMs, redirectsLeft) {
  if (redirectsLeft === undefined) redirectsLeft = MAX_REDIRECTS
  return new Promise((resolve, reject) => {
    const req = https.get(url, { headers: { "User-Agent": READINGS_UA, Accept: "*/*" } }, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location && redirectsLeft > 0) {
        res.resume()
        try {
          const next = new URL(res.headers.location, url).toString()
          resolve(httpsGet(next, maxBytes, timeoutMs, redirectsLeft - 1))
        } catch (e) {
          reject(e)
        }
        return
      }
      if (res.statusCode !== 200) {
        res.resume()
        reject(new Error("HTTP " + res.statusCode))
        return
      }
      const chunks = []
      let total = 0
      let settled = false
      res.on("data", (chunk) => {
        if (settled) return
        total += chunk.length
        if (total > maxBytes) {
          settled = true
          req.destroy()
          reject(new Error("response exceeds byte limit"))
          return
        }
        chunks.push(chunk)
      })
      res.on("end", () => {
        if (settled) return
        settled = true
        resolve(Buffer.concat(chunks).toString("utf8"))
      })
      res.on("error", (err) => {
        if (settled) return
        settled = true
        reject(err)
      })
    })
    req.setTimeout(timeoutMs, () => {
      req.destroy()
      reject(new Error("request timed out"))
    })
    req.on("error", reject)
  })
}

function parseUniversalis(html) {
  if (typeof html !== "string" || html.length > MAX_RESPONSE_BYTES) throw new Error("HTML exceeds byte limit")

  const title = cap(decodeHtml(match1(html, /<span id="feastname"><strong>([\s\S]*?)<\/strong>/)).trim(), FIELD_CAPS.title)
  const rubric = cap(decodeHtml(match1(html, /<p class="rubric"><i>([\s\S]*?)<\/i><\/p>/)).trim(), FIELD_CAPS.rubric)

  let color = ""
  let year = ""
  if (rubric) {
    const cm = rubric.match(/Colour:\s*([^.;]+)/i)
    const ym = rubric.match(/Year:\s*([^.<]+)/i)
    color = cap(cm ? cm[1].trim() : "", FIELD_CAPS.color)
    year = cap(ym ? ym[1].trim() : "", FIELD_CAPS.year)
  }

  const tables = []
  const tableRe = /<table class="each"[^>]*>[\s\S]*?<\/table>/g
  let m
  while ((m = tableRe.exec(html)) !== null) {
    tables.push({ start: m.index, end: m.index + m[0].length, raw: m[0] })
    if (tables.length >= MAX_TABLES) break
  }

  const endIdx = html.indexOf("You can also view")
  const limitEnd = endIdx >= 0 ? endIdx : html.length

  const readings = []
  let seenGospel = false
  for (let i = 0; i < tables.length; i++) {
    if (readings.length >= MAX_READINGS) break
    const t = tables[i]
    const label = decodeHtml(match1(t.raw, /<th align="left">([\s\S]*?)<\/th>/)).trim()
    if (!label || label === "Or:") continue
    const reference = decodeHtml(match1(t.raw, /<th align="right">([\s\S]*?)<\/th>/)).trim()
    const segStart = t.end
    const segEnd = i + 1 < tables.length ? tables[i + 1].start : limitEnd
    const seg = html.slice(segStart, segEnd)

    const heading = decodeHtml(match1(seg, /<h4[^>]*>([\s\S]*?)<\/h4>/)).trim()

    // The Responsorial Psalm repeats its refrain, which universalis marks
    // with <i>. Keep that flag so the panel can render it in bold italics.
    const lines = []
    const lineRe = /<div class="(?:p|pi|v|vi|v gb)"[^>]*>([\s\S]*?)<\/div>/g
    let lm
    while ((lm = lineRe.exec(seg)) !== null) {
      const refrain = /<\/?i\b/i.test(lm[1])
      const line = decodeHtml(lm[1]).trim()
      if (line) lines.push({ t: line, r: refrain })
      if (lines.length >= MAX_LINES_PER_READING) break
    }

    const reading = {
      label: cap(label, FIELD_CAPS.label),
      reference: cap(reference, FIELD_CAPS.reference),
      heading: cap(heading, FIELD_CAPS.heading),
      text: cap(lines.map((l) => l.t).join("\n"), FIELD_CAPS.text),
      lines: lines
    }
    // A second "First reading" that follows a "Gospel" begins the optional
    // set of readings offered on some feasts.
    if (/^gospel$/i.test(label)) seenGospel = true
    if (seenGospel && /^first reading$/i.test(label)) reading.optionalStart = true
    readings.push(reading)
  }

  return { title, color, year, readings }
}

function localIsoDate() {
  const d = new Date()
  return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0")
}

// Read a cached file descriptor-bound: no symlink following, regular-file and
// ownership checks, and a size ceiling.
function cacheRead(file) {
  let fd
  try {
    fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW)
  } catch (e) {
    return null
  }
  try {
    const st = fs.fstatSync(fd)
    if (!st.isFile() || st.isSymbolicLink()) return null
    if (typeof process.getuid === "function" && st.uid !== process.getuid()) return null
    if (st.size <= 0 || st.size > MAX_CACHE_BYTES) return null
    const buf = Buffer.alloc(st.size)
    fs.readSync(fd, buf, 0, st.size, 0)
    return buf.toString("utf8")
  } catch (e) {
    return null
  } finally {
    try { fs.closeSync(fd) } catch (e) {}
  }
}

// Write atomically via a same-directory exclusive temporary file, then rename.
function cacheWrite(file, data) {
  const dir = path.dirname(file)
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 })
  const tmp = path.join(dir, "." + path.basename(file) + ".tmp." + process.pid + "." + Date.now())
  fs.writeFileSync(tmp, data, { flag: "wx", mode: 0o600 })
  fs.renameSync(tmp, file)
}

// Remove cached readings for any other date, keeping only the file just
// written. Restricted to the readings-YYYY-MM-DD.json naming scheme inside
// the cache directory.
function cleanupReadingsCache(dir, keepFile) {
  let entries
  try { entries = fs.readdirSync(dir) } catch (e) { return }
  const keep = path.basename(keepFile)
  for (const name of entries) {
    if (!/^readings-\d{4}-\d{2}-\d{2}\.json$/.test(name)) continue
    if (name === keep) continue
    try { fs.unlinkSync(path.join(dir, name)) } catch (e) {}
  }
}

async function readingsCommand(dateArg, refresh) {
  const date = /^\d{4}-\d{2}-\d{2}$/.test(dateArg || "") ? dateArg : localIsoDate()
  const cacheDir = path.join(os.homedir(), ".local", "state", "omarchy", "catholic-reference")
  const cacheFile = path.join(cacheDir, "readings-" + date + ".json")

  if (!refresh) {
    const cached = cacheRead(cacheFile)
    if (cached) return cached
  }

  const yyyymmdd = date.replace(/-/g, "")
  const url = "https://universalis.com/USA/" + yyyymmdd + "/mass.htm"
  const html = await httpsGet(url, MAX_RESPONSE_BYTES, READINGS_TIMEOUT_MS)
  const parsed = parseUniversalis(html)
  if (!parsed.readings || parsed.readings.length === 0) throw new Error("No readings parsed")

  parsed.date = date
  parsed.source = "universalis.com"

  const json = JSON.stringify(parsed)
  cacheWrite(cacheFile, json + "\n")
  cleanupReadingsCache(cacheDir, cacheFile)
  return json
}

function main() {
  const args = process.argv.slice(2)
  const cmd = args[0]
  if (cmd === "search") {
    const kind = args[1]
    const query = args.slice(2).join(" ")
    if (kind === "bible") searchBible(query)
    else if (kind === "catechism") searchCatechism(query)
    else { status("Unknown search target. Use bible or catechism."); process.exit(2) }
  } else if (cmd === "read") {
    readReference(args.slice(1).join(" "))
  } else if (cmd === "random") {
    const kind = args[1]
    if (kind === "bible") randomVerse()
    else if (kind === "catechism") randomCatechism()
    else { status("Unknown random target. Use bible or catechism."); process.exit(2) }
  } else if (cmd === "readings") {
    const refresh = args.indexOf("--refresh") >= 0
    const dateArg = args[1] && args[1] !== "--refresh" ? args[1] : ""
    readingsCommand(dateArg, refresh)
      .then((json) => process.stdout.write(json + "\n"))
      .catch((err) => process.stdout.write(JSON.stringify({ error: String(err && err.message ? err.message : err) }) + "\n"))
  } else if (cmd === "help" || cmd === "-h" || cmd === "--help") {
    usage()
  } else {
    usage()
    process.exit(2)
  }
}

main()
