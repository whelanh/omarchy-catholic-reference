#!/usr/bin/env python3
"""omarchy-catholic — search backend for the Catholic Reference plugin.

Python 3 port of the original Node.js helper so the plugin needs no language
runtime beyond what Omarchy's base package set already provides (Python ships
with python-gobject and most base tools). The command line, the tab-separated
protocol and the JSON payloads are identical to the Node version.

Reads the bundled Douay-Rheims index (data/bible.tsv), the canonical book
table (data/books.json), and the Catechism (data/catechism.json), and emits
tab-separated results the QML panel can parse:

  STATUS\t<message>        a status/error line
  RESULT\t<ref>\t<text>    one search hit
  NAV\t<label>\t<detail>\t<fill>  a book or chapter; opening it searches <fill>

Commands:
  search bible QUERY       fuzzy text search + reference lookup
  search catechism QUERY   fuzzy search over CCC paragraphs
  read BOOK CH:V           exact reference lookup
  chapter BOOK CH          one chapter as JSON, for the reader
  ccc FIRST LAST           a range of CCC paragraphs as JSON, with headings
  saint [YYYY-MM-DD]       today's liturgy and saint biography as JSON

Fuzzy matching is subsequence-based, so "god so loved" finds
"For God so loved the world…" without an exact quote.
"""

import gzip
import http.client
import json
import os
import random
import re
import socket
import ssl
import stat
import sys
import time
import unicodedata
import urllib.parse
from datetime import date

SCRIPT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA_ROOT = os.path.join(SCRIPT_ROOT, "data")
MAX_RESULTS = 40


def write_out(text):
    """Write to stdout, exiting quietly if the reader closed the pipe."""
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except BrokenPipeError:
            pass
        os._exit(0)


def read_json(path):
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def status(msg):
    write_out("STATUS\t" + str(msg) + "\n")


def result(ref, text):
    # Collapse newlines/tabs so each hit stays a single line the QML panel can
    # split on "\t" and "\n" unambiguously.
    clean = re.sub(r"\s+", " ", str(text or "")).strip()
    write_out("RESULT\t" + ref + "\t" + clean + "\n")


def load_books():
    return read_json(os.path.join(DATA_ROOT, "books.json"))


def load_bible():
    with open(os.path.join(DATA_ROOT, "bible.tsv"), "r", encoding="utf-8") as handle:
        raw = handle.read()
    verses = []
    for line in raw.split("\n"):
        idx = line.find("\t")
        if idx < 0:
            continue
        book = line[:idx]
        rest = line[idx + 1:]
        idx2 = rest.find("\t")
        if idx2 < 0:
            continue
        verses.append({"book": book, "ref": rest[:idx2], "text": rest[idx2 + 1:]})
    return verses


def load_catechism():
    return read_json(os.path.join(DATA_ROOT, "catechism.json"))


# --- fuzzy matching -------------------------------------------------------

def subseq_score(query, text):
    score = 0
    streak = 0
    last_idx = -1
    ti = 0
    for ch in query:
        idx = text.find(ch, ti)
        if idx == -1:
            return 0
        if idx == last_idx + 1:
            streak += 1
        else:
            streak = 0
        bonus = 1
        if idx == 0:
            bonus += 16
        else:
            if text[idx - 1] in " -,.;:('":
                bonus += 10
        score += bonus + min(streak, 5)
        ti = idx + 1
        last_idx = idx
    return score


# Score a query against a text. A single-word query must match as a whole
# word (case-insensitive) so "cremation" never matches "created"/"creation".
# Multi-word phrases keep fuzzy subsequence matching, boosted heavily when
# every word also appears as a whole word.
def score_match(query, text):
    q = str(query).lower().strip()
    if not q:
        return 0
    t = text.lower()
    words = [w for w in re.split(r"\s+", q) if w]

    if len(words) == 1:
        matches = re.findall(r"\b" + re.escape(words[0]) + r"\b", t)
        if not matches:
            return 0
        return 1000 + min(len(matches), 20)

    compact = "".join(words)
    score = subseq_score(compact, t)
    if score == 0:
        return 0
    every_word = True
    for word in words:
        if not re.search(r"\b" + re.escape(word) + r"\b", t):
            every_word = False
            break
    if every_word:
        score += 800
    if q in t:
        score += 400
    return score


# --- book reference parsing -----------------------------------------------

def normalize_name(value):
    return re.sub(r"\s+", " ", re.sub(r"[.\-,]", " ", str(value or "").lower())).strip()


def book_for_token(books, token):
    needle = normalize_name(token)
    if not needle:
        return None
    for book in books:
        if normalize_name(book["name"]) == needle:
            return book
        if normalize_name(book.get("abbrev", "")) == needle:
            return book
        for alias in book.get("aliases", []):
            if normalize_name(alias) == needle:
                return book
    return None


def compact_name(value):
    return normalize_name(value).replace(" ", "")


# Books a typed name could mean. An exact name, abbreviation or alias wins
# outright; otherwise any book whose name starts with what was typed ("mat",
# "1 cor"), or whose alias does once three letters are in ("cant"). Aliases
# are compared with their spaces so "is" never reaches "i samuel".
def books_for_prefix(books, token):
    needle = normalize_name(token)
    if not re.search(r"[a-z]", needle):
        return []
    exact = book_for_token(books, needle)
    if exact:
        return [exact]
    compact = compact_name(needle)
    out = []
    for book in books:
        if compact_name(book["name"]).startswith(compact):
            out.append(book)
        elif len(needle) >= 3 and any(normalize_name(a).startswith(needle) for a in book.get("aliases", [])):
            out.append(book)
    return out


# "mat", "mat 4", "mat4:23", "mat 4:23-25", "1 cor 13". None when the query is
# not shaped like a reference, so it falls through to text search.
# normalize_name turns the range dash into a space, hence "23 25".
def parse_book_query(query):
    normalized = normalize_name(re.sub("[\u2013\u2014]", "-", str(query or "")))
    m = re.match(r"^((?:[1-4] ?)?[a-z][a-z ]*?) ?(?:(\d+)(?: ?: ?(\d+)(?: (\d+))?)?)?$", normalized)
    if not m:
        return None
    verse = int(m.group(3)) if m.group(3) else None
    return {
        "token": m.group(1),
        "chapter": int(m.group(2)) if m.group(2) else None,
        "verse": verse,
        "verseEnd": max(verse, int(m.group(4))) if m.group(4) else verse,
    }


def ref_chapter(ref):
    return int(ref.split(":")[0])


def ref_verse(ref):
    return int(ref.split(":")[1])


# book name -> {chapter -> [verse]}, in canonical order.
def chapter_index(verses):
    index = {}
    for verse in verses:
        chapter = ref_chapter(verse["ref"])
        index.setdefault(verse["book"], {})
        index[verse["book"]].setdefault(chapter, [])
        index[verse["book"]][chapter].append(verse)
    return index


# A row that opens a book or chapter instead of copying: selecting it puts
# `fill` in the search box.
nav_count = 0


def nav(label, detail, fill):
    global nav_count
    nav_count += 1
    write_out("NAV\t" + str(label) + "\t" + re.sub(r"[\t\n]", " ", str(detail)) + "\t" + str(fill) + "\n")


def plural(n, word):
    return str(n) + " " + word + ("" if n == 1 else "s")


# Book/chapter/verse navigation. Returns True when the query was fully
# answered; False lets fuzzy text search run (after any rows written here).
def navigate_bible(query, books, verses):
    parsed = parse_book_query(query)
    if not parsed:
        return False
    matches = books_for_prefix(books, parsed["token"])
    if len(matches) == 0:
        return False
    index = chapter_index(verses)

    if parsed["chapter"] is None:
        if len(matches) == 1:
            book = matches[0]["name"]
            for chapter, verses_in in index.get(book, {}).items():
                nav(book + " " + str(chapter),
                    plural(len(verses_in), "verse") + " · " + verses_in[0]["text"],
                    book + " " + str(chapter))
        else:
            for book in matches:
                nav(book["name"], plural(len(index.get(book["name"], {})), "chapter"), book["name"] + " ")
        return False

    found = []
    for book in matches:
        verses_in = index.get(book["name"], {}).get(parsed["chapter"])
        if not verses_in:
            continue
        if parsed["verse"] is None:
            found.append({"book": book["name"], "list": verses_in})
        else:
            rng = [x for x in verses_in if parsed["verse"] <= ref_verse(x["ref"]) <= parsed["verseEnd"]]
            if len(rng) > 0:
                found.append({"book": book["name"], "list": rng})

    if len(found) == 0:
        if len(matches) == 1:
            chapters = index.get(matches[0]["name"], {})
            verses_in = chapters.get(parsed["chapter"])
            if verses_in:
                status(matches[0]["name"] + " " + str(parsed["chapter"]) + " has " + plural(len(verses_in), "verse"))
            else:
                status(matches[0]["name"] + " has " + plural(len(chapters), "chapter"))
        else:
            status("No verses match: " + query)
        return True

    # Several books share the prefix and only a chapter was given: offer the
    # chapters rather than dumping every verse of each.
    if len(found) > 1 and parsed["verse"] is None:
        for entry in found:
            nav(entry["book"] + " " + str(parsed["chapter"]),
                plural(len(entry["list"]), "verse") + " · " + entry["list"][0]["text"],
                entry["book"] + " " + str(parsed["chapter"]))
        return True

    count = 0
    for entry in found:
        for verse in entry["list"]:
            result(verse["book"] + " " + verse["ref"], verse["text"])
            count += 1
    status(plural(count, "verse"))
    return True


def parse_reference(query, books):
    m = re.match(r"^(.+?)\s+(\d+)(?::(\d+))?$", query.strip())
    if not m:
        return None
    book = book_for_token(books, m.group(1))
    if not book:
        return None
    return {"book": book["name"], "chapter": int(m.group(2)),
            "verse": int(m.group(3)) if m.group(3) else None}


# --- commands -------------------------------------------------------------

def search_bible(query):
    books = load_books()
    q = query.strip()
    if not q:
        status("Type a phrase, word, or reference to search the Bible.")
        return
    verses = load_bible()

    # Book, chapter and verse lookup: "Mat", "Mat 4", "Mat 4:23".
    if navigate_bible(q, books, verses):
        return

    # Fuzzy text search.
    scored = []
    for i, verse in enumerate(verses):
        score = score_match(q, verse["text"])
        if score > 0:
            scored.append((score, i, verse))
    scored.sort(key=lambda item: (-item[0], item[1]))
    top = scored[:MAX_RESULTS]
    if len(top) == 0:
        if nav_count == 0:
            status("No matches for: " + q)
        return
    for _, _, verse in top:
        result(verse["book"] + " " + verse["ref"], verse["text"])
    status(str(len(top)) + " result" + ("" if len(top) == 1 else "s") + " · click to copy")


def search_catechism(query):
    q = query.strip()
    if not q:
        status("Type a word or phrase to search the Catechism.")
        return
    paragraphs = load_catechism()
    scored = []
    for i, paragraph in enumerate(paragraphs):
        score = score_match(q, paragraph["text"])
        if score > 0:
            scored.append((score, i, paragraph))
    scored.sort(key=lambda item: (-item[0], item[1]))
    top = scored[:MAX_RESULTS]
    if len(top) == 0:
        status("No Catechism paragraphs match: " + q)
        return
    for _, _, paragraph in top:
        result("CCC " + str(paragraph["id"]), paragraph["text"])
    status(str(len(top)) + " paragraph" + ("" if len(top) == 1 else "s") + " · click to copy")


def read_reference(reference):
    books = load_books()
    ref = parse_reference(reference, books)
    if not ref:
        status('Unrecognized reference. Try "John 3:16".')
        return
    verses = load_bible()
    prefix = ref["book"] + "\t" + str(ref["chapter"]) + ":" + (str(ref["verse"]) if ref["verse"] else "")
    found = 0
    for verse in verses:
        key = verse["book"] + "\t" + verse["ref"]
        if (key == prefix) if ref["verse"] else key.startswith(prefix):
            result(verse["book"] + " " + verse["ref"], verse["text"])
            found += 1
    if found == 0:
        status("Reference not found: " + reference)


# One chapter for the reader view:
#   {book, chapter, chapters, poetic, verses: [[n, text]]}
def chapter_json(args):
    chapter = int(args[-1])
    book = book_for_token(load_books(), " ".join(args[:-1]))
    out = {"book": book["name"] if book else "", "chapter": chapter,
           "chapters": 0, "poetic": False, "verses": []}
    if book:
        outline = read_json(os.path.join(DATA_ROOT, "outline.json"))
        out["poetic"] = book["name"] in outline["poetic"]
        for verse in load_bible():
            if verse["book"] != book["name"]:
                continue
            c = ref_chapter(verse["ref"])
            n = ref_verse(verse["ref"])
            out["chapters"] = max(out["chapters"], c)
            if c == chapter:
                out["verses"].append([n, verse["text"]])
    write_out(json.dumps(out, ensure_ascii=False, separators=(",", ":")) + "\n")


# A run of Catechism paragraphs for the reader view, with the sub-headings
# ("I. The Desire for God") that start inside it:
#   {first, last, paragraphs: [[n, text]], headings: [[n, title]]}
def catechism_range_json(args):
    first = int(args[0])
    last = int(args[1]) if len(args) > 1 and args[1] else first

    def in_range(n):
        return first <= n <= last

    outline = read_json(os.path.join(DATA_ROOT, "outline.json"))
    out = {
        "first": first,
        "last": last,
        "paragraphs": [[p["id"], p["text"]] for p in load_catechism() if in_range(p["id"])],
        "headings": [h for h in outline["catechismHeadings"] if in_range(h[0])],
    }
    write_out(json.dumps(out, ensure_ascii=False, separators=(",", ":")) + "\n")


def random_verse():
    verses = load_bible()
    if len(verses) == 0:
        status("No Bible data available.")
        return
    i = random.randrange(len(verses))
    verse = verses[i]
    chapter = verse["ref"].split(":")[0]

    # Give a little context: one verse before and after, within the chapter.
    start = i
    end = i
    if i > 0 and verses[i - 1]["book"] == verse["book"] and verses[i - 1]["ref"].split(":")[0] == chapter:
        start = i - 1
    if i + 1 < len(verses) and verses[i + 1]["book"] == verse["book"] and verses[i + 1]["ref"].split(":")[0] == chapter:
        end = i + 1

    start_verse = verses[start]["ref"].split(":")[1]
    end_verse = verses[end]["ref"].split(":")[1]
    reference = (verse["book"] + " " + chapter + ":" + start_verse) if start == end \
        else (verse["book"] + " " + chapter + ":" + start_verse + "-" + end_verse)

    text = " ".join(x["text"] for x in verses[start:end + 1])
    result(reference, text)


def random_catechism():
    paragraphs = load_catechism()
    if len(paragraphs) == 0:
        status("No Catechism data available.")
        return
    paragraph = paragraphs[random.randrange(len(paragraphs))]
    result("CCC " + str(paragraph["id"]), paragraph["text"])


# --- Catena Aurea commentary ----------------------------------------------

_catena_cache = None


def load_catena():
    global _catena_cache
    if _catena_cache is not None:
        return _catena_cache
    file = os.path.join(DATA_ROOT, "catena.json.gz")
    try:
        with gzip.open(file, "rt", encoding="utf-8") as handle:
            _catena_cache = json.load(handle)
    except Exception:
        _catena_cache = []
    return _catena_cache


def commentary_lookup(reference):
    m = re.match(r"^(.+?)\s+(\d+):(\d+)(?:-(\d+))?$", str(reference or "").strip())
    if not m:
        write_out(json.dumps({"reference": reference or "", "p": []}, ensure_ascii=False, separators=(",", ":")) + "\n")
        return
    book = m.group(1)
    chapter = int(m.group(2))
    verse = int(m.group(3))
    for section in load_catena():
        if section["b"] == book and section["c"] == chapter and section["s"] <= verse <= section["e"]:
            write_out(json.dumps({"reference": reference, "p": section["p"]},
                                 ensure_ascii=False, separators=(",", ":")) + "\n")
            return
    write_out(json.dumps({"reference": reference, "p": []}, ensure_ascii=False, separators=(",", ":")) + "\n")


def usage():
    write_out("\n".join([
        "Usage:",
        "  omarchy-catholic search bible QUERY",
        "  omarchy-catholic search catechism QUERY",
        "  omarchy-catholic read BOOK CH:V",
        "  omarchy-catholic random bible|catechism",
        "  omarchy-catholic commentary BOOK CH:V",
        "  omarchy-catholic readings [YYYY-MM-DD] [--refresh]",
        "  omarchy-catholic saint [YYYY-MM-DD]",
        "",
        "Fuzzy search runs locally over the bundled Douay-Rheims Bible and the",
        "Catechism of the Catholic Church. `readings` fetches today's Mass",
        "readings from universalis.com and caches them locally. `saint` reads",
        "the bundled romcal calendar and bundled biographies (daily-saints and",
        "catholic-readings-api); it needs no network access.",
    ]) + "\n")


# --- daily Mass readings (universalis.com) --------------------------------

READINGS_UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
MAX_RESPONSE_BYTES = 256 * 1024
MAX_CACHE_BYTES = 256 * 1024
READINGS_TIMEOUT_MS = 20000
MAX_REDIRECTS = 5
MAX_TABLES = 24
MAX_READINGS = 10
MAX_LINES_PER_READING = 600
FIELD_CAPS = {
    "title": 240,
    "rubric": 160,
    "color": 64,
    "year": 64,
    "label": 120,
    "reference": 240,
    "heading": 600,
    "text": 24000,
}

# --- today's liturgical celebration (bundled data) ------------------------

CALENDAR_PATH = os.path.join(DATA_ROOT, "calendar.json.gz")
SAINTS_PATH = os.path.join(DATA_ROOT, "saints.json.gz")
SAINT_LEARN_MORE = "https://www.franciscanmedia.org/saint-of-the-day/"


def cap(value, maximum):
    s = str(value or "")
    return s[:maximum] if len(s) > maximum else s


def decode_html(value):
    s = str(value)
    s = re.sub(r"<br\s*/?>", "\n", s, flags=re.IGNORECASE)
    s = re.sub(r"<[^>]+>", "", s)

    def hex_entity(m):
        try:
            return chr(int(m.group(1), 16))
        except (ValueError, OverflowError):
            return "\ufffd"

    def dec_entity(m):
        try:
            return chr(int(m.group(1), 10))
        except (ValueError, OverflowError):
            return "\ufffd"

    s = re.sub(r"&#x([0-9a-f]+);", hex_entity, s, flags=re.IGNORECASE)
    s = re.sub(r"&#(\d+);", dec_entity, s)
    s = (s.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<")
         .replace("&gt;", ">").replace("&quot;", '"').replace("&apos;", "'"))
    return s.replace("\u00a0", " ")


def match1(source, pattern):
    m = re.search(pattern, str(source), flags=re.DOTALL)
    return m.group(1) if m else ""


# Fetch an HTTPS body under a strict byte ceiling, a wall-clock deadline and
# bounded redirect following. http.client is used directly rather than
# urllib.request: on a redirect, urllib's default handler drains the redirect
# response with an unbounded fp.read() before the byte ceiling is ever
# applied, so a redirecting server can exhaust memory. Here redirect bodies
# are never read, and only the final 200 body is read in bounded chunks until
# the byte ceiling or the deadline is reached.
def https_get(url, max_bytes, timeout_ms, redirects_left=None):
    if redirects_left is None:
        redirects_left = MAX_REDIRECTS
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or not parsed.hostname:
        raise RuntimeError("unsupported URL")
    timeout = timeout_ms / 1000.0
    deadline = time.monotonic() + timeout
    connection = http.client.HTTPSConnection(
        parsed.hostname,
        parsed.port or 443,
        timeout=timeout,
        context=ssl.create_default_context(),
    )
    try:
        target = parsed.path or "/"
        if parsed.query:
            target += "?" + parsed.query
        connection.request("GET", target, headers={"User-Agent": READINGS_UA, "Accept": "*/*"})
        response = connection.getresponse()
        if response.status in (301, 302, 303, 307, 308):
            location = response.getheader("Location")
            if not location or redirects_left <= 0:
                raise RuntimeError("HTTP " + str(response.status))
            return https_get(urllib.parse.urljoin(url, location), max_bytes, timeout_ms, redirects_left - 1)
        if response.status != 200:
            raise RuntimeError("HTTP " + str(response.status))
        chunks = []
        total = 0
        while True:
            if time.monotonic() >= deadline:
                raise RuntimeError("request timed out")
            chunk = response.read(65536)
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise RuntimeError("response exceeds byte limit")
            chunks.append(chunk)
        return b"".join(chunks).decode("utf-8", "replace")
    except TimeoutError as err:
        raise RuntimeError("request timed out") from err
    except http.client.HTTPException as err:
        raise RuntimeError(str(err) or "network error") from err
    except OSError as err:
        raise RuntimeError(str(err) or "network error") from err
    finally:
        connection.close()


def parse_universalis(html):
    if not isinstance(html, str) or len(html) > MAX_RESPONSE_BYTES:
        raise RuntimeError("HTML exceeds byte limit")

    title = cap(decode_html(match1(html, r'<span id="feastname"><strong>([\s\S]*?)</strong>')).strip(), FIELD_CAPS["title"])
    rubric = cap(decode_html(match1(html, r'<p class="rubric"><i>([\s\S]*?)</i></p>')).strip(), FIELD_CAPS["rubric"])

    color = ""
    year = ""
    if rubric:
        cm = re.search(r"Colour:\s*([^.;]+)", rubric, flags=re.IGNORECASE)
        ym = re.search(r"Year:\s*([^.<]+)", rubric, flags=re.IGNORECASE)
        color = cap(cm.group(1).strip() if cm else "", FIELD_CAPS["color"])
        year = cap(ym.group(1).strip() if ym else "", FIELD_CAPS["year"])

    tables = []
    for m in re.finditer(r'<table class="each"[^>]*>[\s\S]*?</table>', html):
        tables.append({"start": m.start(), "end": m.end(), "raw": m.group(0)})
        if len(tables) >= MAX_TABLES:
            break

    end_idx = html.find("You can also view")
    limit_end = end_idx if end_idx >= 0 else len(html)

    readings = []
    seen_gospel = False
    for i, table in enumerate(tables):
        if len(readings) >= MAX_READINGS:
            break
        label = decode_html(match1(table["raw"], r'<th align="left">([\s\S]*?)</th>')).strip()
        if not label or label == "Or:":
            continue
        reference = decode_html(match1(table["raw"], r'<th align="right">([\s\S]*?)</th>')).strip()
        seg_start = table["end"]
        seg_end = tables[i + 1]["start"] if i + 1 < len(tables) else limit_end
        seg = html[seg_start:seg_end]

        heading = decode_html(match1(seg, r"<h4[^>]*>([\s\S]*?)</h4>")).strip()

        # The Responsorial Psalm repeats its refrain, which universalis marks
        # with <i>. Keep that flag so the panel can render it in bold italics.
        lines = []
        for lm in re.finditer(r'<div class="(?:p|pi|v|vi|v gb)"[^>]*>([\s\S]*?)</div>', seg):
            refrain = re.search(r"</?i\b", lm.group(1), flags=re.IGNORECASE) is not None
            line = decode_html(lm.group(1)).strip()
            if line:
                lines.append({"t": line, "r": refrain})
            if len(lines) >= MAX_LINES_PER_READING:
                break

        reading = {
            "label": cap(label, FIELD_CAPS["label"]),
            "reference": cap(reference, FIELD_CAPS["reference"]),
            "heading": cap(heading, FIELD_CAPS["heading"]),
            "text": cap("\n".join(l["t"] for l in lines), FIELD_CAPS["text"]),
            "lines": lines,
        }
        # A second "First reading" that follows a "Gospel" begins the optional
        # set of readings offered on some feasts.
        if re.match(r"^gospel$", label, flags=re.IGNORECASE):
            seen_gospel = True
        if seen_gospel and re.match(r"^first reading$", label, flags=re.IGNORECASE):
            reading["optionalStart"] = True
        readings.append(reading)

    return {"title": title, "color": color, "year": year, "readings": readings}


def local_iso_date():
    today = date.today()
    return today.strftime("%Y-%m-%d")


# Read a cached file descriptor-bound: no symlink following, regular-file and
# ownership checks, and a size ceiling.
def cache_read(file):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(file, flags)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None
        if hasattr(os, "getuid") and st.st_uid != os.getuid():
            return None
        if st.st_size <= 0 or st.st_size > MAX_CACHE_BYTES:
            return None
        return os.read(fd, st.st_size).decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


# Write atomically via a same-directory exclusive temporary file, then rename.
def cache_write(file, data):
    directory = os.path.dirname(file)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = os.path.join(directory, "." + os.path.basename(file) + ".tmp." + str(os.getpid()) + "." + str(int(time.time() * 1000)))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, data.encode("utf-8"))
    finally:
        os.close(fd)
    os.replace(tmp, file)


# Remove cached readings for any other date, keeping only the file just
# written. Restricted to the readings-YYYY-MM-DD.json naming scheme inside the
# cache directory.
def cleanup_readings_cache(directory, keep_file):
    try:
        entries = os.listdir(directory)
    except OSError:
        return
    keep = os.path.basename(keep_file)
    for name in entries:
        if not re.match(r"^readings-\d{4}-\d{2}-\d{2}\.json$", name):
            continue
        if name == keep:
            continue
        try:
            os.unlink(os.path.join(directory, name))
        except OSError:
            pass


def readings_command(date_arg, refresh):
    day = date_arg if re.match(r"^\d{4}-\d{2}-\d{2}$", date_arg or "") else local_iso_date()
    cache_dir = os.path.join(os.path.expanduser("~"), ".local", "state", "omarchy", "catholic-reference")
    cache_file = os.path.join(cache_dir, "readings-" + day + ".json")

    if not refresh:
        cached = cache_read(cache_file)
        if cached:
            return cached

    yyyymmdd = day.replace("-", "")
    url = "https://universalis.com/USA/" + yyyymmdd + "/mass.htm"
    html = https_get(url, MAX_RESPONSE_BYTES, READINGS_TIMEOUT_MS)
    parsed = parse_universalis(html)
    if not parsed.get("readings"):
        raise RuntimeError("No readings parsed")

    parsed["date"] = day
    parsed["source"] = "universalis.com"

    payload = json.dumps(parsed, ensure_ascii=False, separators=(",", ":"))
    cache_write(cache_file, payload + "\n")
    cleanup_readings_cache(cache_dir, cache_file)
    return payload


_calendar_cache = None
_saints_cache = None


def load_calendar():
    global _calendar_cache
    if _calendar_cache is None:
        try:
            with gzip.open(CALENDAR_PATH, "rt", encoding="utf-8") as handle:
                _calendar_cache = json.load(handle)
        except (OSError, ValueError) as err:
            raise RuntimeError("The bundled liturgical calendar is missing or invalid.") from err
    return _calendar_cache


def load_saints():
    global _saints_cache
    if _saints_cache is None:
        try:
            with gzip.open(SAINTS_PATH, "rt", encoding="utf-8") as handle:
                _saints_cache = json.load(handle)
        except (OSError, ValueError) as err:
            raise RuntimeError("The bundled saint biographies are missing or invalid.") from err
    return _saints_cache


# Must match keysForName()/normalizeName() in tools/build-calendar.mjs. The
# build indexes every source name under both its normalised form and any
# alias, so the runtime only needs the normalised romcal name.
def normalize_person_name(name):
    s = unicodedata.normalize("NFKD", str(name or ""))
    s = "".join(ch for ch in s if not unicodedata.combining(ch))
    s = s.lower()
    s = re.sub(r"\([^)]*\)", " ", s)
    s = re.sub(r"^\s*(pope\s+)?saints?\b\.?\s*", "", s)
    s = re.sub(r"^\s*(blessed|saint)\b\.?\s*", "", s)
    s = s.split(",")[0]
    s = re.sub(r"\band\s+(his\s+|her\s+)?companions?\b", " ", s)
    s = re.sub(r"[^a-z0-9]+", " ", s)
    return re.sub(r"\s+", " ", s).strip().removeprefix("the ")


def biography_for(name, saints):
    entry = saints.get(normalize_person_name(name))
    return entry if isinstance(entry, dict) else None


# Today's celebration comes from the bundled romcal calendar; biographies are
# matched by name from the bundled daily-saints / catholic-readings-api index.
# No network access is needed for this command.
def saint_command(date_arg):
    day = date_arg if re.match(r"^\d{4}-\d{2}-\d{2}$", date_arg or "") else local_iso_date()
    calendar = load_calendar()
    entries = calendar.get(day)
    if not entries:
        raise RuntimeError("No calendar data is available for " + day[:4] + ". Update the plugin to add this year.")

    saints = load_saints()
    celebrations = []
    featured = 0
    for index, entry in enumerate(entries):
        celebration = dict(entry)
        biography = biography_for(celebration.get("name", ""), saints)
        if biography:
            for field in ("summary", "quote", "legacy", "era", "wikipedia"):
                value = biography.get(field)
                if value:
                    celebration[field] = value
            patronage = biography.get("patronage")
            if patronage:
                celebration["patronage"] = patronage
            sources = biography.get("sources")
            if sources:
                celebration["biographySources"] = sources
        celebrations.append(celebration)
        if featured == 0 and celebration.get("rank") not in ("WEEKDAY", "SUNDAY"):
            featured = index

    return json.dumps({
        "date": day,
        "season": celebrations[0].get("season", "") if celebrations else "",
        "celebrations": celebrations,
        "featured": featured,
        "learnMore": SAINT_LEARN_MORE,
        "source": "romcal; biographies: daily-saints and catholic-readings-api",
    }, ensure_ascii=False, separators=(",", ":"))


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else None
    if cmd == "search":
        kind = args[1] if len(args) > 1 else None
        query = " ".join(args[2:])
        if kind == "bible":
            search_bible(query)
        elif kind == "catechism":
            search_catechism(query)
        else:
            status("Unknown search target. Use bible or catechism.")
            sys.exit(2)
    elif cmd == "read":
        read_reference(" ".join(args[1:]))
    elif cmd == "random":
        kind = args[1] if len(args) > 1 else None
        if kind == "bible":
            random_verse()
        elif kind == "catechism":
            random_catechism()
        else:
            status("Unknown random target. Use bible or catechism.")
            sys.exit(2)
    elif cmd == "chapter":
        chapter_json(args[1:])
    elif cmd == "ccc":
        catechism_range_json(args[1:])
    elif cmd == "commentary":
        commentary_lookup(" ".join(args[1:]))
    elif cmd == "readings":
        refresh = "--refresh" in args
        date_arg = args[1] if len(args) > 1 and args[1] != "--refresh" else ""
        try:
            write_out(readings_command(date_arg, refresh) + "\n")
        except Exception as err:  # noqa: BLE001 - surface any failure as JSON
            write_out(json.dumps({"error": str(err)}, ensure_ascii=False, separators=(",", ":")) + "\n")
    elif cmd == "saint":
        date_arg = args[1] if len(args) > 1 and args[1] != "--refresh" else ""
        try:
            write_out(saint_command(date_arg) + "\n")
        except Exception as err:  # noqa: BLE001 - surface any failure as JSON
            write_out(json.dumps({"error": str(err)}, ensure_ascii=False, separators=(",", ":")) + "\n")
    elif cmd in ("help", "-h", "--help"):
        usage()
    else:
        usage()
        sys.exit(2)


if __name__ == "__main__":
    main()
